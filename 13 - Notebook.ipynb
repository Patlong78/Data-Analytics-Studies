    "# Coal influence analysis by country\n",
    "coal_country_summary = recent_df.groupby('country').agg(\n",
    "    total_co2=('co2', 'sum'),\n",
    "    coal_co2=('coal_co2', 'sum'),\n",
    "    gas_co2=('gas_co2', 'sum'),\n",
    "    oil_co2=('oil_co2', 'sum')\n",
