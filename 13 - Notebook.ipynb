    "import time\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, f1_score,\n",
    "    confusion_matrix, classification_report\n",
    ")\n",
    "from qiskit.circuit.library import ZZFeatureMap\n",
    "from qiskit_machine_learning.kernels import FidelityQuantumKernel\n",
    "\n",
    "# ── 1. Pearson Correlation — find best 2 features ────────────────────────────\n",
    "print(\"=\" * 60)\n",
    "print(\"  STEP 1 — Pearson Correlation with Target (co2_high)\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# All numeric features available\n",
    "numeric_cols = model_df.select_dtypes(include='number').columns.tolist()\n",
    "numeric_cols = [c for c in numeric_cols if c != 'co2_high']\n",
    "\n",
    "# Compute Pearson correlation with target\n",
    "correlations = model_df[numeric_cols].corrwith(\n",
    "    model_df['co2_high'], method='pearson'\n",
    ").abs().sort_values(ascending=False)\n",
    "\n",
    "print(\"\\nPearson |correlation| with co2_high (all features):\")\n",
    "print(correlations.round(4).to_string())\n",
    "\n",
    "# ── Plot correlation bar chart ────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "fig.suptitle(\"Pearson Correlation with CO₂ High Target\", \n",
    "             fontsize=14, fontweight='bold')\n",
    "\n",
    "# Full correlation\n",
    "correlations.plot(kind='barh', ax=axes[0], \n",
    "                  color=['#C0392B' if v > 0.5 else '#3266AD' \n",
    "                         for v in correlations],\n",
    "                  edgecolor='white', alpha=0.85)\n",
    "axes[0].set_title('All Features — |Pearson r|', fontsize=12, fontweight='bold')\n",
    "axes[0].set_xlabel('|Correlation|')\n",
    "axes[0].axvline(0.5, color='orange', lw=2, linestyle='--', \n",
    "                label='Threshold 0.5')\n",
    "axes[0].legend(fontsize=9)\n",
    "axes[0].spines[['top', 'right']].set_visible(False)\n",
    "\n",
    "# Correlation matrix heatmap (top 8 features)\n",
    "top8 = correlations.head(8).index.tolist() + ['co2_high']\n",
    "corr_matrix = model_df[top8].corr(method='pearson')\n",
    "sns.heatmap(corr_matrix, ax=axes[1], annot=True, fmt='.2f',\n",
    "            cmap='RdYlGn', center=0, square=True,\n",
    "            linewidths=0.5, annot_kws={'size': 8})\n",
    "axes[1].set_title('Correlation Matrix — Top 8 Features', \n",
    "                  fontsize=12, fontweight='bold')\n",
    "axes[1].tick_params(labelsize=8)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('pearson_correlation.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"\\n✅ Correlation plot saved.\")\n",
    "\n",
    "# ── Pick top 2 features ───────────────────────────────────────────────────────\n",
    "top2_features = correlations.head(2).index.tolist()\n",
    "print(f\"\\n🏆 Top 2 features selected for Quantum Kernel:\")\n",
    "print(f\"   Feature 1: {top2_features[0]}  (r = {correlations[top2_features[0]]:.4f})\")\n",
    "print(f\"   Feature 2: {top2_features[1]}  (r = {correlations[top2_features[1]]:.4f})\")\n",
    "\n",
    "# ── 2. Prepare data — ALL samples, top 2 features ────────────────────────────\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"  STEP 2 — Prepare Data (ALL samples, top 2 features)\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "quantum_feature_cols = top2_features\n",
    "\n",
    "quantum_data = model_df[quantum_feature_cols].copy()\n",
    "scaler = StandardScaler()\n",
    "quantum_data[quantum_feature_cols] = scaler.fit_transform(\n",
    "    quantum_data[quantum_feature_cols]\n",
    ")\n",
    "quantum_X = quantum_data.to_numpy()\n",
    "quantum_y = model_df['co2_high'].to_numpy()\n",
    "\n",
    "print(f\"\\nTotal samples:   {len(quantum_X)}\")\n",
    "print(f\"Features used:   {quantum_feature_cols}\")\n",
    "print(f\"Class balance:   {np.bincount(quantum_y)} (0=Low, 1=High)\")\n",
    "\n",
    "# Train/test split — 80/20 on ALL samples\n",
    "quantum_X_train, quantum_X_test, quantum_y_train, quantum_y_test = train_test_split(\n",
    "    quantum_X,\n",
    "    quantum_y,\n",
    "    test_size=0.2,\n",
    "    random_state=42,\n",
    "    stratify=quantum_y,\n",
    ")\n",
    "\n",
    "print(f\"Training samples: {len(quantum_X_train)}\")\n",
    "print(f\"Test samples:     {len(quantum_X_test)}\")\n",
    "\n",
    "# ── 3. Quantum Kernel + SVM ───────────────────────────────────────────────────\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"  STEP 3 — Quantum Kernel (ZZFeatureMap) + SVM\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Note: large datasets may take time on simulator\n",
    "# Subsample if needed for tractability\n",
    "MAX_TRAIN = 200   # ← increase if your machine allows\n",
    "MAX_TEST  = 50\n",
    "\n",
    "if len(quantum_X_train) > MAX_TRAIN:\n",
    "    print(f\"\\n⚠️  Subsampling train to {MAX_TRAIN} rows for quantum simulation.\")\n",
    "    idx = np.random.RandomState(42).choice(\n",
    "        len(quantum_X_train), MAX_TRAIN, replace=False\n",
    "    )\n",
    "    quantum_X_train_q = quantum_X_train[idx]\n",
    "    quantum_y_train_q = quantum_y_train[idx]\n",
    "else:\n",
    "    quantum_X_train_q = quantum_X_train\n",
    "    quantum_y_train_q = quantum_y_train\n",
    "\n",
    "if len(quantum_X_test) > MAX_TEST:\n",
    "    print(f\"⚠️  Subsampling test  to {MAX_TEST} rows for quantum simulation.\")\n",
    "    idx2 = np.random.RandomState(42).choice(\n",
    "        len(quantum_X_test), MAX_TEST, replace=False\n",
    "    )\n",
    "    quantum_X_test_q = quantum_X_test[idx2]\n",
    "    quantum_y_test_q = quantum_y_test[idx2]\n",
    "else:\n",
    "    quantum_X_test_q = quantum_X_test\n",
    "    quantum_y_test_q = quantum_y_test\n",
    "\n",
    "# Feature map — 2 qubits, 1 rep for speed\n",
    "quantum_feature_map = ZZFeatureMap(feature_dimension=2, reps=1)\n",
    "quantum_kernel      = FidelityQuantumKernel(feature_map=quantum_feature_map)\n",
    "\n",
    "print(f\"\\nComputing quantum kernel matrices...\")\n",
    "print(f\"  Train kernel: {len(quantum_X_train_q)} × {len(quantum_X_train_q)}\")\n",
    "print(f\"  Test kernel:  {len(quantum_X_test_q)} × {len(quantum_X_train_q)}\")\n",
    "\n",
    "start_time = time.perf_counter()\n",
    "\n",
    "quantum_train_kernel = quantum_kernel.evaluate(quantum_X_train_q)\n",
    "quantum_test_kernel  = quantum_kernel.evaluate(\n",
    "    quantum_X_test_q, quantum_X_train_q\n",
    ")\n",
    "\n",
    "quantum_svm = SVC(kernel='precomputed', random_state=42)\n",
    "quantum_svm.fit(quantum_train_kernel, quantum_y_train_q)\n",
    "quantum_y_pred = quantum_svm.predict(quantum_test_kernel)\n",
    "\n",
    "quantum_elapsed_time = time.perf_counter() - start_time\n",
    "\n",
    "# ── 4. Metrics ────────────────────────────────────────────────────────────────\n",
    "quantum_cm = confusion_matrix(quantum_y_test_q, quantum_y_pred, labels=[0, 1])\n",
    "quantum_tn, quantum_fp, quantum_fn, quantum_tp = quantum_cm.ravel()\n",
    "\n",
    "quantum_specificity = (\n",
    "    quantum_tn / (quantum_tn + quantum_fp)\n",
    "    if (quantum_tn + quantum_fp) != 0 else 0.0\n",
    ")\n",
    "quantum_sensitivity = (\n",
    "    quantum_tp / (quantum_tp + quantum_fn)\n",
    "    if (quantum_tp + quantum_fn) != 0 else 0.0\n",
    ")\n",
    "\n",
    "quantum_sim_metrics_df = pd.DataFrame([{\n",
    "    'Model':       'Qiskit Quantum Kernel + SVM',\n",
    "    'Features':    f\"{top2_features[0]}, {top2_features[1]}\",\n",
    "    'Train N':     len(quantum_X_train_q),\n",
    "    'Test N':      len(quantum_X_test_q),\n",
    "    'Accuracy':    round(accuracy_score(quantum_y_test_q, quantum_y_pred), 4),\n",
    "    'Precision':   round(precision_score(quantum_y_test_q, quantum_y_pred, zero_division=0), 4),\n",
    "    'Sensitivity': round(quantum_sensitivity, 4),\n",
    "    'Specificity': round(quantum_specificity, 4),\n",
    "    'F1 Score':    round(f1_score(quantum_y_test_q, quantum_y_pred, zero_division=0), 4),\n",
    "    'Time (sec)':  round(quantum_elapsed_time, 4),\n",
    "}])\n",
    "\n",
    "# ── 5. Print results ──────────────────────────────────────────────────────────\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"  RESULTS — Qiskit Quantum Kernel + SVM\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"\\nFeatures:  {top2_features[0]}  |  {top2_features[1]}\")\n",
    "print(f\"Pearson r: {correlations[top2_features[0]]:.4f}  |  {correlations[top2_features[1]]:.4f}\")\n",
    "print(f\"Train rows: {len(quantum_X_train_q)} | Test rows: {len(quantum_X_test_q)}\")\n",
    "print(f\"Quantum kernel computation time: {quantum_elapsed_time:.2f} sec\\n\")\n",
    "print(quantum_sim_metrics_df.drop(columns=['Features','Train N','Test N']).to_string(index=False))\n",
    "print(\"\\nClassification Report:\")\n",
    "print(classification_report(quantum_y_test_q, quantum_y_pred, \n",
    "                             labels=[0, 1], zero_division=0))\n",
    "\n",
    "# ── 6. Confusion matrix plot ──────────────────────────────────────────────────\n",
    "from sklearn.metrics import ConfusionMatrixDisplay\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "fig.suptitle('Quantum Kernel SVM — Results', fontsize=13, fontweight='bold')\n",
    "\n",
    "# Confusion matrix\n",
    "ConfusionMatrixDisplay(\n",
    "    confusion_matrix=quantum_cm,\n",
    "    display_labels=['Low CO₂', 'High CO₂']\n",
    ").plot(ax=axes[0], colorbar=False, cmap='Blues')\n",
    "axes[0].set_title(f'Confusion Matrix\\n({top2_features[0]} + {top2_features[1]})',\n",
    "                  fontsize=11, fontweight='bold')\n",
    "\n",
    "# Metrics bar chart\n",
    "metrics = ['Accuracy', 'Precision', 'Sensitivity', 'Specificity', 'F1 Score']\n",
    "values  = [quantum_sim_metrics_df[m].values[0] for m in metrics]\n",
    "colors_bar = ['#3266AD','#8E44AD','#2E8B57','#E07B39','#C0392B']\n",
    "axes[1].bar(metrics, values, color=colors_bar, alpha=0.85, edgecolor='white')\n",
    "axes[1].set_ylim(0, 1.15)\n",
    "axes[1].set_title('Classification Metrics', fontsize=11, fontweight='bold')\n",
    "axes[1].set_ylabel('Score')\n",
    "for i, v in enumerate(values):\n",
    "    axes[1].text(i, v + 0.02, f'{v:.3f}', ha='center', \n",
    "                 fontsize=10, fontweight='bold')\n",
    "axes[1].spines[['top', 'right']].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('quantum_kernel_results.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"✅ Results plot saved.\")"
   ]
